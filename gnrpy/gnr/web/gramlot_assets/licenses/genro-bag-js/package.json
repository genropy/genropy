{
  "name": "genro-bag-js",
  "version": "0.4.0",
  "description": "JavaScript port of genro-bag - hierarchical data container",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/python-alignment.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:coverage": "c8 --reporter=lcov --reporter=text node --test tests/*.test.js"
  },
  "keywords": [
    "bag",
    "hierarchical",
    "xml",
    "builder",
    "genro"
  ],
  "author": "Genropy Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/genropy/genro-bag-js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@xmldom/xmldom": "^0.8.11",
    "big.js": "^7.0.1",
    "genro-tytx": "git+https://github.com/genropy/genro-tytx.git#v0.15.0"
  },
  "devDependencies": {
    "c8": "^10.1.2"
  },
  "imports": {
    "#uuid": {
      "node": "./src/node-uuid.js",
      "default": "./src/browser-uuid.js"
    }
  }
}
